<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpreadsheetApp.MainPage"
             Title="Електронна таблиця">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="10" RowSpacing="5">

        <ScrollView Grid.Row="0" Orientation="Horizontal">
            <HorizontalStackLayout Spacing="3">
                <Button Text="Відкрити" Clicked="OpenButton_Clicked" />
                <Button Text="Зберегти" Clicked="SaveButton_Clicked" />
                <Button Text="Зберегти як" Clicked="SaveAsButton_Clicked" />
                <Button Text="Порахувати" Clicked="CalculateButton_Clicked" />
                <Button x:Name="modeButton" Text="Режим: ЗНАЧЕННЯ" Clicked="ModeButton_Clicked" />
                <Button Text="Вставити рядок" Clicked="InsertRowButton_Clicked" />
                <Button Text="Видалити рядок" Clicked="DeleteRowButton_Clicked" />
                <Button Text="Вставити стовпець" Clicked="InsertColumnButton_Clicked" />
                <Button Text="Видалити стовпець" Clicked="DeleteColumnButton_Clicked" />
                <Button Text="Довідка" Clicked="HelpButton_Clicked" />
                <Button Text="Вийти" Clicked="ExitButton_Clicked" />
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="60,*" ColumnSpacing="5">
            <Label Grid.Column="0" x:Name="cellNameLabel" Text="" FontAttributes="Bold"
                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            <Entry Grid.Column="1" x:Name="formulaEntry" Placeholder="Вираз вибраної клітинки"
                   Completed="FormulaEntry_Completed" />
        </Grid>

        <ScrollView Grid.Row="2" Orientation="Both">
            <Grid x:Name="grid" HorizontalOptions="Start" VerticalOptions="Start" />
        </ScrollView>

        <Label Grid.Row="3" x:Name="statusLabel" Text="Виберіть клітинку та введіть вираз" />
    </Grid>

</ContentPage>
